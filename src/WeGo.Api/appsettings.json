{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Data Source=travelism.db",
    "BusyTimeoutMs": 5000,
    "EnableWal": true
  },
  "Auth": {
    "SigningKey": "",
    "CookieName": "travelism_session",
    "CookieDays": 90
  },
  "RateLimits": {
    "JoinPerMinute": 10,
    "GlobalPerMinute": 600,
    "CreateTripPerHour": 5,
    "GeocodePerMinute": 30
  },
  "Geocoding": {
    "BaseAddress": "https://nominatim.openstreetmap.org/",
    "UserAgent": "Travelism-TripPlanner/0.1 (+https://github.com/travelism/trip-planner)",
    "TimeoutSeconds": 5,
    "MinIntervalMs": 1000,
    "CacheMinutes": 30,
    "BiasBoxDegrees": 0.5,
    "AcceptLanguage": "vi,en"
  }
}
